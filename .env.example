NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tidepost
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
# Generate with: openssl rand -base64 32 (required before decrypting/publishing provider tokens)
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
META_GRAPH_API_VERSION=v23.0
LINKEDIN_API_VERSION=202601
# Optional OAuth client credentials are configured server-side only.
# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
