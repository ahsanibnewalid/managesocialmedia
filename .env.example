NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tidepost
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
# Generate with: openssl rand -base64 32 (required before decrypting/publishing provider tokens)
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# META_GRAPH_API_VERSION=configure-current-supported-version
# LINKEDIN_API_VERSION=configure-current-supported-version
# Optional OAuth client credentials are configured server-side only.
# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# OAuth callback base URL must exactly match each provider's configured redirect URI.
# APP_URL=https://your-public-domain.example
# Required Meta OAuth credentials; use a current Graph API version supported by your app.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_API_VERSION=
# LinkedIn developer app credentials and API version enabled for your app.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=
# X developer app OAuth 2.0 credentials.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TikTok developer app credentials.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Protect the scheduled analytics sync endpoint; do not expose this value to the browser.
# CRON_SECRET=

# SaaS billing (server-side secrets only; never expose NEXT_PUBLIC_ values)
# SSLCOMMERZ sandbox first. Live credentials must come from your approved merchant account.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
# International gateway is deliberately not enabled until business-country eligibility,
# settlement, recurring billing, refunds, and webhook verification are confirmed.
# INTERNATIONAL_PAYMENT_PROVIDER=
# INTERNATIONAL_PAYMENT_SECRET_KEY=
# INTERNATIONAL_PAYMENT_WEBHOOK_SECRET=

# Dashboard-managed payment gateway credentials (never commit real values)
# Generate: openssl rand -base64 32
BILLING_CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated owner email allowlist; platform-owner privileges are deployment-controlled.
TIDEPOST_OWNER_EMAILS=
