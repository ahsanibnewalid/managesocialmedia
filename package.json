{
  "name": "tidepost-console",
  "version": "1.1.0",
  "private": true,
  "description": "Tidepost social media management console — Next.js app and BullMQ publishing worker",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:legacy": "node server/index.js",
    "dev:legacy": "node --watch server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker:publish": "node --import tsx server/publishing-worker.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:rollback": "tsx scripts/migrate.ts --down"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.5.28",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {},
  "overrides": {
    "postcss": "^8.5.23"
  }
}
